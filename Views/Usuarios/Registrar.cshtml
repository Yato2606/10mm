@model _10mm.Models.RegistroViewModel

@{
    ViewData["Title"] = "Registro de Usuario - 10mm";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h2 class="fw-bold mb-0">🔧 10mm</h2>
                    <p class="text-muted mb-0 text-uppercase small tracking-wider" style="color: #a0a0a0 !important;">Alta de Usuarios y Personal</p>
                </div>
                <div class="card-body p-4 p-sm-5 bg-light">

                    <form asp-action="Registrar" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <!-- Alertas de validación globales -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Sección: Rol -->
                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-semibold text-secondary">Tipo de Usuario / Rol</label>
                            <select asp-for="Rol" id="ddlRol" class="form-select form-select-lg border-2">
                                <option value="" selected disabled>-- Selecciona un Rol --</option>
                                <option value="Mecanico">👨‍🔧 Mecánico</option>
                                <option value="Cliente">🚘 Cliente</option>
                                <!-- <option value="Administrador">👑 Administrador</option>-->
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <!-- Sección dinámica: Selector de Taller (Solo para Mecánicos) -->
                        <div class="mb-4 d-none" id="divTaller">
                            <label asp-for="IdTaller" class="form-label fw-semibold text-secondary">Asignar a Taller</label>
                            <select asp-for="IdTaller" class="form-select border-2" asp-items="ViewBag.Talleres">
                                <option value="">-- Selecciona el Taller donde trabaja --</option>
                            </select>
                            <span asp-validation-for="IdTaller" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted my-4">

                        <!-- Datos Personales -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary">Nombre(s)</label>
                            <input asp-for="Nombre" class="form-for-control form-control border-2" placeholder="Ej. Juan" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="ApellidoPaterno" class="form-label fw-semibold text-secondary">Apellido Paterno</label>
                                <input asp-for="ApellidoPaterno" class="form-control border-2" placeholder="Ej. Pérez" />
                                <span asp-validation-for="ApellidoPaterno" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="ApellidoMaterno" class="form-label fw-semibold text-secondary">Apellido Materno</label>
                                <input asp-for="ApellidoMaterno" class="form-control border-2" placeholder="Ej. Rodríguez (Opcional)" />
                                <span asp-validation-for="ApellidoMaterno" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold text-secondary">Correo Electrónico</label>
                                <input asp-for="Correo" type="email" class="form-control border-2" placeholder="juan@correo.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold text-secondary">Teléfono Celular</label>
                                <input asp-for="Telefono" type="tel" class="form-control border-2" placeholder="6641234567" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="text-muted my-4">

                        <!-- Contraseñas -->
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold text-secondary">Contraseña</label>
                                <input asp-for="Password" class="form-control border-2" placeholder="Mínimo 6 caracteres" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="ConfirmarPassword" class="form-label fw-semibold text-secondary">Confirmar Contraseña</label>
                                <input asp-for="ConfirmarPassword" class="form-control border-2" placeholder="Repite la contraseña" />
                                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Botón de Envío -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-dark btn-lg fw-bold shadow-sm rounded-3 py-3">
                                🚀 Registrar Usuario
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Scripts de Validación nativos de .NET para validar sin recargar la página -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ddlRol = document.getElementById("ddlRol");
            const divTaller = document.getElementById("divTaller");

            function verificarRol() {
                // Si el rol seleccionado es Mecanico, mostramos el campo de taller, si no, lo ocultamos
                if (ddlRol.value === "Mecanico") {
                    divTaller.classList.remove("d-none");
                } else {
                    divTaller.classList.add("d-none");
                }
            }

            // Escuchar cuando el usuario cambie de opción en el Selector de Rol
            ddlRol.addEventListener("change", verificarRol);
        });
    </script>
}